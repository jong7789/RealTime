{
    "permissions": {
        "allow": [
            "Read",
            "Grep",
            "Glob",
            "Edit",
            "Write",
            "Bash(*)"
        ],
        "deny": [
            "Bash(rm:*)",
            "Bash(mv:*)",
            "Bash(cp:*)",
            "Bash(chmod:*)",
            "Bash(sed:*)",
            "Bash(sudo:*)",
            "Bash(python:*)"
        ],
        "defaultMode": "acceptEdits"
    },
    "enabledPlugins": {
        "github@claude-plugins-official": true
    },
    "enablePowerShellTool": true
}